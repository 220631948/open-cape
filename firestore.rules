rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && getUserProfile().role == 'admin';
    }

    function isTenantMember(tenantId) {
      return signedIn() && getUserProfile().tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && getUserProfile().role == 'owner';
    }

    function hasTenantAccess(docTenantId) {
      return isSuperAdmin() || isTenantMember(docTenantId);
    }

    function isOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function isAnalyst() {
       return signedIn() && getUserProfile().role == 'analyst';
    }

    function ownerUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function validPrivacy() {
      return !('privacy' in request.resource.data) ||
        request.resource.data.privacy in ['private', 'shared', 'public'];
    }

    // System health check endpoint
    match /system/health_check {
      allow read: if true;
    }

    // Public source metadata only
    match /source_catalog/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin() || isAnalyst();
      allow write: if isSelf(uid) || isSuperAdmin();
    }

    match /user_profiles/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if isSelf(uid) || isSuperAdmin();
    }

    match /map_layers/{layerId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin() || (signedIn() && resource != null && isOwner(resource.data.ownerUid));
      allow create: if signedIn(); 
    }

    match /tenants/{tenantId} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.token.tenantId == tenantId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (signedIn() && request.auth.token.tenantId == tenantId && request.auth.token.role == 'tenant_admin');
      allow delete: if isSuperAdmin();
    }
    
    match /impersonation_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false; // written by admin sdk
    }

    // Private layer preferences keyed by uid
    match /layer_preferences/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.ownerUid == request.auth.uid;
    }

    match /saved_views/{uid}/views/{viewId} {
      allow create, read, update, delete: if isSelf(uid);
    }

    // Private saved maps
    match /saved_maps/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validPrivacy();
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged()
        && validPrivacy();
    }

    // Private saved projects
    match /saved_projects/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validPrivacy();
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged()
        && validPrivacy();
    }

    // Private bookmarks
    match /bookmarks/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Drawings
    match /drawings/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete, update: if isSuperAdmin() || isOwner(resource.data.ownerUid);
    }

    // Private annotations
    match /annotations/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Private tasks
    match /tasks/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Project evidence
    match /project_evidence/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Recent searches are private
    match /recent_searches/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    match /watchlists/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    match /match_logs/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Optional read-only sharing later
    match /shared_views/{docId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if resource.data.isPublic == true
        || isOwner(resource.data.ownerUid);
      allow delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        && ownerUnchanged();
    }

    // Public ERF records
    match /erfs/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /verified_locations/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.verifiedBy == request.auth.uid;
      allow update: if signedIn() && request.resource.data.verifiedBy == request.auth.uid && resource.data.verifiedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.verifiedBy == request.auth.uid;
    }

    match /property_data/{docId} {
      allow read: if signedIn();
      // Only analysts or superadmins can write property data directly (or cloud functions)
      allow write: if isSuperAdmin() || isAnalyst();
    }


    
    match /tenants/{tenantId}/config/{docId} {
      allow read: if isTenantMember(tenantId);
      allow create, update, delete: if isTenantOwner(tenantId);
    }
    
    match /tenants/{tenantId}/roles/{roleId} {
      allow read: if isTenantMember(tenantId);
      allow create, update, delete: if isTenantOwner(tenantId);
    }
    
    match /importedGeoJsonLayers/{layerId} {
      allow create: if signedIn() && isTenantMember(request.resource.data.tenantId);
      allow read: if signedIn() && hasTenantAccess(resource.data.tenantId);
      allow update, delete: if signedIn() && hasTenantAccess(resource.data.tenantId);

      match /features/{featureId} {
        allow create: if signedIn() && isTenantMember(get(/databases/$(database)/documents/importedGeoJsonLayers/$(layerId)).data.tenantId);
        allow read: if signedIn() && hasTenantAccess(get(/databases/$(database)/documents/importedGeoJsonLayers/$(layerId)).data.tenantId);
        allow update, delete: if signedIn() && hasTenantAccess(get(/databases/$(database)/documents/importedGeoJsonLayers/$(layerId)).data.tenantId);
      }
    }
    
    // Also add rule for gis_reports
    match /gis_reports/{reportId} {
        allow read, write: if signedIn() || true;
    }

    // System/admin collections locked down by default
    match /audit_logs/{docId} {
      allow read, write: if false;
    }

    match /dataset_sync_runs/{docId} {
      allow read, write: if false;
    }

    match /dataset_cache/{docId} {
      allow read, write: if false;
    }

    match /feature_cache/{docId} {
      allow read, write: if false;
    }

    // Agent run state and analytical outputs
    match /agentState/{uid} {
      allow read, write: if isSelf(uid);
    }

    match /analytics/{uid}/{document=**} {
      allow read, write: if isSelf(uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
